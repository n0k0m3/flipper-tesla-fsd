# Options for every board. The target and the board come from
# boards/<board-id>.defaults (tools/build-boards.sh). ESP-IDF also reads
# sdkconfig.defaults.<target> after this file.

# 4 MB flash or more on every board. Two app slots: a new OTA image boots as
# "pending" and rolls back if the app does not confirm it. Secure Boot stays
# off: it burns eFuses for good.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 1 ms tick: the CAN task waits and the timers count in ms. The SPI backends
# poll the controller once per tick.
CONFIG_FREERTOS_HZ=1000

# The TWAI interrupt stamps the receive time. Let it run while the flash cache
# is off (NVS write, OTA write), so a flash write cannot delay the stamp. Its
# callbacks in scrl_can_twai.cpp and scrl_can.cpp are in RAM and call only RAM
# and ROM code.
CONFIG_TWAI_ISR_CACHE_SAFE=y

# BLE: NimBLE, one phone at a time. No Wi-Fi. The central and observer roles
# link the BLE remote buttons of the TSL6 engine (up to 3, scrl_central.h).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
# NimBLE warnings and errors only: its INFO lines (one per notify) flood the
# USB console.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# The host task also writes NVS and the update image.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192

# Phones: LE Secure Connections only, with the passkey (scrl_ble.cpp checks
# each link), bonds kept in NVS, at most 2 phone bonds (scrl_ble.cpp counts
# them). Legacy pairing is built in for the BLE remotes only: scrl_central.cpp
# allows it during the pairing of a remote. 5 bonds = 2 phones + 3 remotes.
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_SC_ONLY=1
CONFIG_BT_NIMBLE_SM_LVL=4
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=5
